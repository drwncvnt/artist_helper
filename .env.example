# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate strong secrets, e.g.:
#   openssl rand -hex 32

# Postgres password for the platform database.
POSTGRES_PASSWORD=

# Secret used to sign session tokens (JWT). Must be long and random.
# The gateway and accounts service share this value.
JWT_SECRET=

# Secret used by the beats tool to sign time-limited track streaming tokens.
SIGNING_SECRET=

# Secret shared by the gateway, accounts and the tools that need to know who
# the user is. Proves a request came through the gateway, so no other
# container can impersonate a user. Must be long and random.
GATEWAY_SECRET=

# Beats tool limits (optional; defaults shown): upload cap, total storage per
# account, and the free disk space below which uploads are refused.
# Note: Cloudflare's Free and Pro plans reject request bodies over 100 MB.
BEATS_MAX_UPLOAD_MB=200
BEATS_USER_QUOTA_MB=1024
BEATS_MIN_FREE_DISK_MB=10240

# Audio Tag Editor upload cap (optional; default 100).
TAGS_MAX_UPLOAD_MB=100

# Audio -> MIDI tool limits (optional; defaults shown). Clips are capped by both
# size and length to keep each transcription bounded.
TRANSCRIBE_MAX_UPLOAD_MB=25
TRANSCRIBE_MAX_DURATION_SECONDS=60

# Audio Analyzer tool limits (optional; defaults shown).
ANALYZER_MAX_UPLOAD_MB=40
ANALYZER_MAX_DURATION_SECONDS=300

# Background Remover tool limits (optional; defaults shown). Model is
# isnet-general-use (good CPU quality/memory balance); u2netp is lighter/lower
# quality if the 2-CPU allocation ever needs more headroom. Only
# BGREMOVE_MAX_CONCURRENT_JOBS users are processed at once; anyone beyond that
# queues and waits (up to BGREMOVE_MAX_QUEUE_WAITING waiting at a time before
# new arrivals are turned away).
BGREMOVE_MODEL=isnet-general-use
BGREMOVE_MAX_UPLOAD_MB=15
BGREMOVE_MAX_IMAGE_PIXELS=25000000
BGREMOVE_MAX_CONCURRENT_JOBS=2
BGREMOVE_MAX_QUEUE_WAITING=20

# Name of the shared session cookie (optional; default shown).
SESSION_COOKIE_NAME=dp_session

# Session lifetime in seconds (optional; default 30 days).
SESSION_TTL_SECONDS=2592000

# Set to "true" in any real (HTTPS) deployment so the session cookie is only
# sent over TLS. Keep "false" only for local http:// testing.
COOKIE_SECURE=false

# Set to "true" when the site is served through Cloudflare. Rate limits then
# use the real visitor address from CF-Connecting-IP instead of a shared
# Cloudflare edge address. The header is only believed when the request
# actually arrived from a Cloudflare edge IP, so direct hits on the origin
# can't fake it.
TRUST_CF_CONNECTING_IP=false

# Host port the gateway is published on (optional; default 4000).
GATEWAY_PORT=4000
